# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SINGLE_SWEEP_149_PRICE_ID=
STRIPE_ANNUAL_PLAN_PRICE_ID=
STRIPE_MONTHLY_PLAN_PRICE_ID=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_MODE=sandbox   # or live

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# In Twilio, set the number's "A message comes in" webhook to https://<your-domain>/api/sms/inbound (HTTP POST)

# Optional: protects the daily automation endpoint (Vercel sends it automatically)
CRON_SECRET=

# Optional: Google Business review link shown after 4-5 star portal reviews
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
ADMIN_PHONE_NUMBER=

# Internal API (server-to-server SMS triggers, cron jobs)
INTERNAL_API_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Anthropic (AI Photo Screening)
ANTHROPIC_API_KEY=

# Google Maps — enable Maps JavaScript API AND Places API on this key in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_KEY=


# TikTok (Phase 4)
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ACTIVE_THEME=dark   # or retro
